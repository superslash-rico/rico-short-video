  "presenter_layout_conventions": {
    "rectangles": "[x,y,width,height]相对最终画布归一化，左上为原点；源裁切另引用实际素材坐标",
    "timing": "主工程绝对帧数，区间左闭右开；必要关键帧填写master_frame与rect_normalized_xywh",
    "planning": "布局是按镜头填写的编辑决策；窗形、抠像和转场能力须实际验证"
  },
  "source_mode_conventions": {
    "allowed_modes": [
      "face_talking_head",
      "screen_explainer",
      "mixed"
    ],
    "entry_paths": [
      "plan_first",
      "existing_footage"
    ],
    "assessment": "制作状态保存主判断、素材角色与可用区间，本清单引用而不另造冲突判断；混合按镜头填source_mode",
    "screen_anchor_fields": "每项锚点据实际事件记录event、source_material_id、source_time_seconds、master_frame、spoken_anchor和evidence_reference，不把示例字段当工具参数",
    "roi_keyframes": "需要时记录source_time_seconds、source_roi_xyxy_pixels及master_frame；坐标指实际源帧，不假设手持画面固定",
    "applicability": "不适用检查写not_applicable并在not_applicable_reasons中记录原因；适用但未检查保持not_checked，不能假填passed",
    "capture_methods": [
      "phone_screen",
      "screen_recording",
      "dual_source"
    ],
    "protected_regions": "仅在需要的段记录含义、有效主区间、源ROI或主分镜引用、动画让位方式；随手持移动更新，复用现有锚点与坐标，不重复维护冲突时码。",
    "real_device_audio": "按语义记录preserve/remove/duck等真实处理及理由；现场有信息的播报与无关失败提示分开判断。",
    "alpha_production_method": "明确native、postprocessed_graphics或none；alpha验证通过不自动证明模板原生alpha。"
  },
  "mg_design_conventions": {
    "scope": "仅动画创作更新；presenter_layout、background_layers、screen_action_context及其原有约束继续有效",
    "objects": "按需要记录object_id、meaning、before、visible_transformation、after及真实素材引用，保持整体/特写的身份连续",
    "tracks": "camera_track记录观察目的、实际实现、起止构图/路径/抵达；object_action_track记录对象自身动作，两者分开，区间引用同一主分镜并使用局部秒数",
    "reading_holds": "记录完整阅读单位、抵达/离开时刻与必要轻微运动；具体时长按实际语音和手机可读性确定",
    "same_version_manifest": "主时轴→源码/支持模块摘要→保存属性/实例覆盖→实际预览/导出→检查范围；当前绑定优先于文件夹版本号",
    "legacy": "旧模板字段保留兼容，无需给原生MG伪填模板ID、MotionGit源或烘焙文件；不适用项写原因",
    "validation": "设计自查、存储绑定、原生合成、实际编码、连续观看、完整试听、用户审美及观众理解各记真实状态"
  },
  "shared_mg_conventions": {
    "background_modes": [
      "shared_professional_mg",
      "same_time_video_with_tint",
      "transparent_overlay_on_footage"
    ],
    "reading_regions": "Used for framing/layout calculations; never becomes an internal scene clip",
    "background_checks": "Same-time background-video/tint checks may be not_applicable for shared professional background with a reason; presenter sync and actual camera/parallax checks still apply",
    "benchmark": "Match same content in 16:9 and 9:16; do not infer aesthetic acceptance from technical success",
    "background_layering": "base/glow/dots behind opaque objects, then presenter and native captions; shade surfaces locally instead of fading paper opacity",
    "accepted_case": "references/data/first-native-mg-case.json; reuse accepted style, validate new content and composition"
  },
  "packaging_style": {
    "corner_brand_mark_default": false,
    "captions": "native editable, accurate wording/timing, clear hierarchy and restrained semantic emphasis",
    "music": "bright positive energetic instrumental; check actual speech mix and ducking",
    "evidence": "Record actual scope for watching, listening, technical checks and user acceptance separately"
  }
